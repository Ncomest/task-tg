# Development only. Replace credentials before deployment.
POSTGRES_USER=task_tg
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=task_tg
POSTGRES_PORT=5432
DATABASE_URL=postgresql://task_tg:local_dev_password@localhost:5432/task_tg?schema=public
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
INIT_DATA_MAX_AGE_SECONDS=300
SESSION_TTL_SECONDS=604800
# Server-only token used by the local agent worker. Generate at least 32 random characters.
# AGENT_WORKER_TOKEN=replace-with-at-least-32-random-characters
# TELEGRAM_BOT_TOKEN is server-only. Set it on the VPS; never use a VITE_ variable.
