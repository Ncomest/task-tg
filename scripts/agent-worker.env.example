# Copy to <repo>/.agent-worker.env and fill in real values. Never commit that file.
# The worker runs on this computer and needs the API URL and the same worker token as the server.

AGENT_API_URL=http://127.0.0.1:3000
AGENT_WORKER_TOKEN=replace-with-the-same-32-plus-character-token-as-the-server

# Repository whose base branch will be used for isolated worktrees.
# AGENT_REPO_DIR is a legacy fallback for TASK_TG; configure both projects explicitly.
AGENT_REPO_DIR=C:/Users/ПК/task-tg
AGENT_REPO_DIR_TASK_TG=C:/Users/ПК/task-tg
AGENT_REPO_DIR_TG_BUDGET=C:/Users/ПК/tg-budget
AGENT_BASE_BRANCH=main

# OpenCode CLI. On the desktop app the binary is usually under
# %APPDATA%/ai.opencode.desktop/cli/<version>/opencode-cli.exe.
AGENT_OPENCODE_BIN=C:/path/to/opencode-cli.exe

# Optional model override in provider/model#variant form.
# AGENT_MODEL=anthropic/claude-sonnet-5-5#high

AGENT_POLL_SECONDS=10
AGENT_TIMEOUT_MINUTES=45
AGENT_INSTALL=true
# tg-budget is a static app without package.json; do not run npm ci there.
AGENT_INSTALL_TG_BUDGET=false
AGENT_PUSH=true
AGENT_PR=true
AGENT_FETCH=true
AGENT_ONCE=false

# Used only in the pull request body, for example https://task-tg.example:8443/
AGENT_APP_URL=
